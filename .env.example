# ==============================================================================
# PaperFeed Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# DO NOT commit .env containing actual secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenAlex API Configuration
# ------------------------------------------------------------------------------
# OpenAlex Polite Pool Email:
# OpenAlex requests that API consumers identify themselves in the "polite pool".
# Supplying a valid academic or personal email gives you access to the dedicated
# polite pool with higher rate limits (up to 10 requests/second).
OPENALEX_EMAIL=your_email@domain.edu

# OpenAlex API Key:
# Optional, but recommended for large crawls or high-throughput batch ingestion.
# Obtain a free API key at https://openalex.org. Using an API key raises rate
# limits (up to 100 requests/second) and avoids "429 Insufficient budget" errors.
OPENALEX_API_KEY=

